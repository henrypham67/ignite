{{- $selected := includeTemplate "selected.json" . | fromJson -}}
# PowerShell profile, managed by ignite (chezmoi). $PROFILE dot-sources this
# file through a one-line shim, so OneDrive-redirected Documents don't matter.
# Machine-only additions go in ~/.config/powershell/profile.local.ps1.

# kubectl plugins installed by krew (kubectl-krew, kubectl-ctx, ...).
$env:PATH = (Join-Path $HOME '.krew/bin') + [IO.Path]::PathSeparator + $env:PATH

if (Get-Module -ListAvailable -Name PSReadLine) {
    # Without a real console (scripts, CI, some editor terminals) PSReadLine
    # warns, or on Windows fails, on every start; stay quiet there.
    try {
        Set-PSReadLineOption -EditMode Emacs -PredictionSource History -PredictionViewStyle ListView -WarningAction SilentlyContinue -ErrorAction Stop
    }
    catch {
        Write-Verbose "PSReadLine options not applied: $($_.Exception.Message)"
    }
}

if (Get-Command mise -ErrorAction SilentlyContinue) {
    (& mise activate pwsh) | Out-String | Invoke-Expression
}
if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}

# Tab completion, generated by ignite for each CLI.
$igniteCompletions = Join-Path $HOME '.cache/ignite/completions'
if (Test-Path -LiteralPath $igniteCompletions) {
    Get-ChildItem -LiteralPath $igniteCompletions -Filter '*.ps1' | ForEach-Object { . $_.FullName }
}

# Secrets live outside the repo; fill them in ~/.config/ignite/secrets.ps1.
$igniteSecrets = Join-Path $HOME '.config/ignite/secrets.ps1'
if (Test-Path -LiteralPath $igniteSecrets) { . $igniteSecrets }
{{- if eq .ignite.git_host "gitlab" }}
$env:GITLAB_URL = {{ .ignite.gitlab_url | squote }}
{{- end }}

# Same short commands as zsh. Built-in aliases with these names (gl, gp, gcm)
# would win over functions, so they go first.
{{- range $alias, $def := .aliases }}
Remove-Alias -Name {{ $alias }} -Force -ErrorAction SilentlyContinue
function {{ $alias }} { {{ get $def "windows" | default $def.cmd }} @args }
{{- end }}

$igniteLocal = Join-Path $HOME '.config/powershell/profile.local.ps1'
if (Test-Path -LiteralPath $igniteLocal) { . $igniteLocal }
{{- if hasKey $selected "starship" }}

if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (& starship init powershell)
}
{{- end }}

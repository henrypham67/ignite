{{- /* Space-separated secret names that apply to this machine. */ -}}
{{- $names := list -}}
{{- range .secret_names -}}
{{-   if or (not (hasKey . "when")) (and (eq .when "gitlab") (eq $.ignite.git_host "gitlab")) -}}
{{-     $names = append $names .name -}}
{{-   end -}}
{{- end -}}
{{ join " " $names }}

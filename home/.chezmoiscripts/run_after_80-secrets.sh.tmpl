{{- if ne .ignite.os "windows" -}}
#!/bin/bash
# Make sure ~/.config/ignite/secrets.env exists, is private, and lists every
# expected name. Existing lines are never rewritten; missing names are added
# with an empty value for the owner to fill in.
set -euo pipefail
file="$HOME/.config/ignite/secrets.env"
mkdir -p "$(dirname "$file")"
if [ ! -f "$file" ]; then
  ( umask 077; printf '# ignite secrets: fill in the values. Never committed; loaded by your shell.\n' > "$file" )
fi
chmod 600 "$file"
# A last line without a newline would swallow the first name appended.
if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then
  printf '\n' >> "$file"
fi
for name in {{ includeTemplate "secret-names" . | trim }}; do
  grep -Eq "^(export )?$name=" "$file" || printf '%s=\n' "$name" >> "$file"
done
{{ end -}}

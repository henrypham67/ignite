{{- if eq .ignite.os "windows" -}}
{{ template "secrets.ps1" . }}
{{- $names := includeTemplate "secret-names" . | trim }}
Sync-IgniteSecretsFile -Path (Join-Path $HOME '.config/ignite/secrets.ps1') -Names @({{ range $i, $n := splitList " " $names }}{{ if $n }}{{ if $i }}, {{ end }}'{{ $n }}'{{ end }}{{ end }})
{{ end -}}

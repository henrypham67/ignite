{{- $selected := includeTemplate "selected.json" . | fromJson -}}
{{- $items := list -}}
{{- range $name, $entry := $selected -}}
{{-   if eq (toString (get $entry "completion")) "cobra" }}{{ $items = append $items $name }}{{ end -}}
{{- end -}}
{{- if and (eq .ignite.os "windows") $items -}}
# Tab completion scripts for PowerShell, one per CLI, loaded by the profile.
{{ template "lib.ps1" . }}
Update-IgnitePath
Reset-IgniteReport -Source completions
$completions = Join-Path $HOME '.cache/ignite/completions'
New-Item -ItemType Directory -Force -Path $completions | Out-Null

function Save-IgniteCompletion {
    param([string]$Name, [string]$Bin)
    Invoke-IgniteTry -Source completions -Item $Name -ScriptBlock {
        $text = & $Bin completion powershell | Out-String
        if ($LASTEXITCODE -ne 0) { throw "$Bin completion powershell exited $LASTEXITCODE" }
        Set-Content -LiteralPath (Join-Path $completions "$Bin.ps1") -Value $text -Encoding utf8NoBOM
    }.GetNewClosure()
}
{{  range $name := $items }}
{{-   $entry := get $selected $name }}
Save-IgniteCompletion -Name '{{ $name }}' -Bin '{{ get $entry "bin" | default $name }}'
{{- end }}
{{ end -}}

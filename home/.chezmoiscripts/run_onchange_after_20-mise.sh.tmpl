{{- $selected := includeTemplate "selected.json" . | fromJson -}}
{{- $items := includeTemplate "mise-order.json" . | fromJson -}}
{{- if and (ne .ignite.os "windows") $items -}}
#!/bin/bash
# Versioned CLIs and runtimes from the ignite catalog, installed per user by mise.
set -uo pipefail
{{ template "lib.sh" . }}
ig_path_setup
ig_reset mise
export MISE_YES=1
{{- range $name := $items }}
{{-   $entry := get $selected $name }}
ig_try mise {{ $name }} mise install {{ $entry.mise }}@{{ get $entry "version" | default "latest" | toString }}
{{- end }}
{{ end -}}

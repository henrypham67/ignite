{{- $selected := includeTemplate "selected.json" . | fromJson -}}
{{- if and (eq .ignite.os "windows") (hasKey $selected "windows-terminal") -}}
# Runs on every apply; only writes settings.json when a value differs.
{{ template "lib.ps1" . }}
{{ template "windows-terminal-settings.ps1" . }}
Reset-IgniteReport -Source windows-terminal
$settings = Join-Path $env:LOCALAPPDATA 'Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'
if (-not (Test-Path -LiteralPath $settings)) {
    Add-IgniteReport -Source windows-terminal -Status skipped -Item windows-terminal -Detail 'open Windows Terminal once, then chezmoi apply'
}
else {
    Invoke-IgniteTry -Source windows-terminal -Item windows-terminal -ScriptBlock {
        if (Update-IgniteTerminalSettings -Path $settings) { Write-Output 'Windows Terminal settings updated' }
    }
}
{{ end -}}

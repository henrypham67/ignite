{{- $selected := includeTemplate "selected.json" . | fromJson -}}
{{- $items := includeTemplate "mise-order.json" . | fromJson -}}
{{- if and (eq .ignite.os "windows") $items -}}
# Versioned CLIs and runtimes from the ignite catalog, installed per user by mise.
{{ template "lib.ps1" . }}
Update-IgnitePath
# ignite's profile activates mise only in PowerShell 7; Windows PowerShell 5.1,
# cmd and editors find mise tools through the shims.
Add-IgniteUserPath -Dir (Join-Path $env:LOCALAPPDATA 'mise\shims')
Reset-IgniteReport -Source mise
$env:MISE_YES = '1'

function Install-IgniteMise {
    param([string]$Name, [string]$Spec)
    Invoke-IgniteTry -Source mise -Item $Name -ScriptBlock { mise install $Spec }.GetNewClosure()
}
{{  range $name := $items }}
{{-   $entry := get $selected $name }}
Install-IgniteMise -Name '{{ $name }}' -Spec '{{ $entry.mise }}@{{ get $entry "version" | default "latest" | toString }}'
{{- end }}
{{ end -}}

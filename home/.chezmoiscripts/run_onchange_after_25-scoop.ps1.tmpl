{{- $selected := includeTemplate "selected.json" . | fromJson -}}
{{- $scoop := list -}}
{{- $wingetUser := list -}}
{{- $needsExtras := false -}}
{{- range $name, $entry := $selected -}}
{{-   if eq $entry.method "scoop" -}}
{{-     $scoop = append $scoop $name -}}
{{-     if hasPrefix "extras/" $entry.scoop }}{{ $needsExtras = true }}{{ end -}}
{{-   else if eq $entry.method "winget_user" -}}
{{-     $wingetUser = append $wingetUser $name -}}
{{-   end -}}
{{- end -}}
{{- if and (eq .ignite.os "windows") (or $scoop $wingetUser) -}}
# Per-user installs: Scoop apps, and winget packages that have a per-user
# installer. Neither needs admin.
{{ template "lib.ps1" . }}
Update-IgnitePath
Reset-IgniteReport -Source scoop

function Install-IgniteScoop {
    param([string]$Name, [string]$App)
    Invoke-IgniteTry -Source scoop -Item $Name -ScriptBlock { scoop install $App }.GetNewClosure()
}

function Install-IgniteWingetUser {
    param([string]$Name, [string]$Id)
    Invoke-IgniteTry -Source scoop -Item $Name -ScriptBlock {
        winget list --id $Id -e --accept-source-agreements --disable-interactivity *> $null
        if ($LASTEXITCODE -eq 0) {
            Write-Output "$Id is already installed"
            return
        }
        winget install --id $Id -e --silent --scope user --accept-package-agreements --accept-source-agreements --disable-interactivity
    }.GetNewClosure()
}
{{- if $needsExtras }}

Invoke-IgniteTry -Source scoop -Item scoop-extras-bucket -ScriptBlock {
    if (@(scoop bucket list | ForEach-Object { $_.Name }) -notcontains 'extras') { scoop bucket add extras }
}
{{- end }}
{{- range $name := $scoop }}
Install-IgniteScoop -Name '{{ $name }}' -App '{{ (get $selected $name).scoop }}'
{{- end }}
{{- range $name := $wingetUser }}
Install-IgniteWingetUser -Name '{{ $name }}' -Id '{{ (get $selected $name).winget }}'
{{- end }}
{{ end -}}

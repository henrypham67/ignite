{{- $checks := includeTemplate "doctor-checks.tsv" . | trim -}}
# ignite-doctor: what's installed, what's missing, and what's left to do by
# hand. Generated by ignite (chezmoi) for this machine; run it any time.
# Exit status: 1 if a tool is missing for no recorded reason, else 0.
{{ template "lib.ps1" . }}

$IgniteChecks = @'
{{ $checks }}
'@

function Get-IgniteCheckRow {
    foreach ($line in ($IgniteChecks -split "`r?`n")) {
        $f = $line -split "`t"
        if ($f.Count -lt 7) { continue }
        [pscustomobject]@{ Row = $f[0]; Name = $f[1]; Job = $f[2]; Method = $f[3]; Kind = $f[4]; Value = $f[5]; Spec = $f[6] }
    }
}

function Get-IgniteReportRow {
    $report = Get-IgniteReportPath
    if (-not (Test-Path -LiteralPath $report)) { return }
    foreach ($line in Get-Content -LiteralPath $report) {
        $f = $line -split "`t"
        if ($f.Count -ge 4) { [pscustomobject]@{ Source = $f[0]; Status = $f[1]; Item = $f[2]; Detail = $f[3] } }
    }
}

$script:IgniteKrewList = $null
$script:IgniteCodeList = $null

function Test-IgniteCheck {
    param([string]$Kind, [string]$Value)
    switch ($Kind) {
        'bin' { return [bool](Get-Command $Value -ErrorAction SilentlyContinue) }
        'path' {
            if ([IO.Path]::IsPathRooted($Value)) { return (Test-Path -LiteralPath $Value) }
            return (Test-Path -LiteralPath (Join-Path $HOME $Value))
        }
        'krew' {
            if ($null -eq $script:IgniteKrewList) {
                $script:IgniteKrewList = @()
                if (Get-Command kubectl -ErrorAction SilentlyContinue) { $script:IgniteKrewList = @(kubectl krew list 2>$null) }
            }
            return ($script:IgniteKrewList -contains $Value)
        }
        'vscode' {
            if ($null -eq $script:IgniteCodeList) {
                $script:IgniteCodeList = @()
                $code = Get-Command code.cmd, code -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty Source
                if ($code) { $script:IgniteCodeList = @(& $code --list-extensions 2>$null) }
            }
            return [bool]($script:IgniteCodeList | Where-Object { $_ -eq $Value })
        }
        default { return $true }
    }
}

# Like Test-IgniteCheck, but a program Windows itself ships is not something
# the owner installed.
function Test-IgniteAlternative {
    param([string]$Kind, [string]$Value)
    if ($Kind -eq 'bin') {
        $command = Get-Command $Value -ErrorAction SilentlyContinue | Select-Object -First 1
        if (-not $command) { return $false }
        return -not ("$($command.Source)" -like "$env:SystemRoot\*")
    }
    return (Test-IgniteCheck -Kind $Kind -Value $Value)
}

function Get-IgniteVersion {
    param([string]$Spec)
    if (-not (Get-Command mise -ErrorAction SilentlyContinue)) { return '' }
    return "$(mise current $Spec 2>$null | Select-Object -First 1)"
}

# True when the command exists and the script block exits 0.
function Test-IgniteSucceed {
    param([string]$Command, [scriptblock]$ScriptBlock)
    if (-not (Get-Command $Command -ErrorAction SilentlyContinue)) { return $true }
    try {
        & $ScriptBlock *> $null
        return ($LASTEXITCODE -eq 0)
    }
    catch { return $false }
}

# True when the command exists and the script block prints something.
function Test-IgniteOutput {
    param([string]$Command, [scriptblock]$ScriptBlock)
    if (-not (Get-Command $Command -ErrorAction SilentlyContinue)) { return $true }
    try { return [bool](& $ScriptBlock | Out-String).Trim() }
    catch { return $false }
}

function Get-IgniteManualStep {
    $steps = @()
    if (-not (Test-IgniteSucceed -Command gh -ScriptBlock { gh auth status })) {
        $steps += 'Sign in to GitHub: gh auth login'
    }
{{- if eq .ignite.git_host "gitlab" }}
{{-   $host := .ignite.gitlab_url | trimPrefix "https://" | trimPrefix "http://" | trimSuffix "/" }}
    if (-not (Test-IgniteSucceed -Command glab -ScriptBlock { glab auth status --hostname '{{ $host }}' })) {
        $steps += 'Sign in to GitLab: glab auth login --hostname {{ $host }}'
    }
{{- end }}
{{- if .ignite.cloud_aws }}
    if (-not (Test-IgniteOutput -Command aws -ScriptBlock { aws configure list-profiles })) {
        $steps += 'Set up AWS access: aws configure sso'
    }
{{- end }}
{{- if .ignite.cloud_azure }}
    if (-not (Test-IgniteSucceed -Command az -ScriptBlock { az account show })) {
        $steps += 'Sign in to Azure: az login'
    }
{{- end }}
{{- if .ignite.cloud_gcp }}
    if (-not (Test-IgniteOutput -Command gcloud -ScriptBlock { gcloud auth list --format='value(account)' })) {
        $steps += 'Sign in to Google Cloud: gcloud auth login'
    }
{{- end }}
    $pub = Join-Path $HOME '.ssh/id_ed25519.pub'
    if (Test-Path -LiteralPath $pub) {
        $steps += "Add this laptop's SSH key at https://github.com/settings/ssh/new{{ if eq .ignite.git_host "gitlab" }} and {{ .ignite.gitlab_url | trimSuffix "/" }}/-/user_settings/ssh_keys{{ end }}:"
        $steps += "    $(Get-Content -Raw -LiteralPath $pub)".TrimEnd()
        $steps += 'Optional: give the key a passphrase: ssh-keygen -p -f ~/.ssh/id_ed25519'
    }
    $secrets = Join-Path $HOME '.config/ignite/secrets.ps1'
    if (Test-Path -LiteralPath $secrets) {
        $empty = foreach ($line in Get-Content -LiteralPath $secrets) {
            if ($line -match "^\s*\`$env:([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(''|`"`")\s*$") { $Matches[1] }
        }
        if ($empty) { $steps += "Fill in secrets in ~/.config/ignite/secrets.ps1: $($empty -join ' ')" }
    }
    $oneLiner = 'curl -fsSL https://raw.githubusercontent.com/henrypham67/ignite/main/bootstrap.sh | bash'
    if ($env:IGNITE_CA_CERT_INSTALLED -match '^([A-Za-z]):[\\/](.*)$') {
        $ca = '/mnt/' + $Matches[1].ToLower() + '/' + ($Matches[2] -replace '\\', '/')
        $oneLiner = "curl --cacert '$ca' -fsSL https://raw.githubusercontent.com/henrypham67/ignite/main/bootstrap.sh | IGNITE_CA_CERT='$ca' bash"
    }
    $steps += "Set up the Linux side: open Ubuntu (WSL) and run: $oneLiner"
    return $steps
}

function Invoke-IgniteDoctor {
    Update-IgnitePath
    Write-Host "ignite doctor - windows, {{ if .ignite.admin }}admin{{ else }}no admin{{ end }}"
    Write-Host ''
    $rows = @(Get-IgniteCheckRow)
    $report = @(Get-IgniteReportRow)
    $ok = 0; $missing = 0; $needs = 0

    Write-Host 'Tools'
    foreach ($row in $rows | Where-Object Row -EQ 'expect') {
        if (Test-IgniteCheck -Kind $row.Kind -Value $row.Value) {
            $status = 'ok'
            if ($row.Kind -eq 'none') { $status = 'unchecked' }
            $version = ''
            if ($row.Method -eq 'mise') { $version = Get-IgniteVersion -Spec $row.Spec }
            Write-Host ('  {0,-9} {1,-42} {2}' -f $status, $row.Name, $version)
            $ok++
        }
        elseif ($report | Where-Object { $_.Status -eq 'needs-it' -and $_.Item -eq $row.Name }) {
            Write-Host ('  {0,-9} {1}' -f 'needs IT', $row.Name)
            $needs++
        }
        elseif ($report | Where-Object { $_.Status -eq 'skipped' -and $_.Item -eq $row.Name }) {
            Write-Host ('  {0,-9} {1}' -f 'skipped', $row.Name)
        }
        else {
            Write-Host ('  {0,-9} {1}' -f 'MISSING', $row.Name)
            $missing++
        }
    }

    $duplicates = foreach ($row in $rows | Where-Object Row -EQ 'alt') {
        if (Test-IgniteAlternative -Kind $row.Kind -Value $row.Value) {
            $chosen = ($rows | Where-Object { $_.Row -eq 'expect' -and $_.Job -eq $row.Job } | Select-Object -First 1).Name
            if (-not $chosen) { $chosen = 'nothing' }
            "  $($row.Job): $chosen (selected) and $($row.Name) (also installed)"
        }
    }
    if ($duplicates) {
        Write-Host ''
        Write-Host 'Duplicates (one tool per job; remove the extra if you like)'
        $duplicates | ForEach-Object { Write-Host $_ }
    }

    foreach ($section in @(@('needs-it', 'Needs IT (no admin rights here)'), @('skipped', 'Skipped'))) {
        $items = @($report | Where-Object Status -EQ $section[0])
        if ($items) {
            Write-Host ''
            Write-Host $section[1]
            $items | ForEach-Object { Write-Host "  $($_.Item): $($_.Detail)" }
        }
    }
    $failed = @($report | Where-Object Status -EQ 'failed')
    if ($failed) {
        Write-Host ''
        Write-Host 'Failed installs'
        $failed | ForEach-Object { Write-Host "  $($_.Item) ($($_.Source)): $($_.Detail)" }
        Write-Host '  Retry: chezmoi state delete-bucket --bucket=scriptState; chezmoi apply'
    }

    $steps = @(Get-IgniteManualStep)
    if ($steps) {
        Write-Host ''
        Write-Host 'Manual steps'
        $steps | ForEach-Object { Write-Host "  [ ] $_" }
    }

    Write-Host ''
    Write-Host ('Summary: {0} ok, {1} missing, {2} needs IT, {3} failed' -f $ok, $missing, $needs, $failed.Count)
    if ($missing -gt 0) { return 1 }
    return 0
}

if ($env:IGNITE_SOURCE_ONLY -ne '1') { exit (Invoke-IgniteDoctor) }

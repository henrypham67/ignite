{{- $checks := includeTemplate "doctor-checks.tsv" . | trim -}}
#!/usr/bin/env bash
# ignite-doctor: what's installed, what's missing, and what's left to do by
# hand. Generated by ignite (chezmoi) for this machine; run it any time.
# Exit status: 1 if a tool is missing for no recorded reason, else 0.
set -uo pipefail
{{ template "lib.sh" . }}
ig_path_setup

CHECKS=$(cat <<'IGNITE_CHECKS'
{{ $checks }}
IGNITE_CHECKS
)
REPORT=$(ig_report_path)
[ -f "$REPORT" ] || REPORT=/dev/null

# report_detail <status> <item>: detail of the matching report row, or nothing.
report_detail() {
  awk -F '\t' -v s="$1" -v i="$2" '$2 == s && $3 == i { print $4; exit }' "$REPORT"
}

KREW_LIST=""
if command -v kubectl >/dev/null 2>&1; then
  KREW_LIST=$(kubectl krew list 2>/dev/null || true)
fi
CODE_LIST=""
code_cli=$(command -v code || true)
if [ -z "$code_cli" ]; then
  read -r -a candidates <<< "${IG_CODE_SEARCH-/opt/homebrew/bin/code /usr/local/bin/code $HOME/.local/bin/code}"
  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    if [ -x "$candidate" ]; then
      code_cli=$candidate
      break
    fi
  done
fi
if [ -n "$code_cli" ]; then
  CODE_LIST=$("$code_cli" --list-extensions 2>/dev/null || true)
fi

# present <kind> <value>
present() {
  case "$1" in
    bin) command -v "$2" >/dev/null 2>&1 ;;
    path)
      case "$2" in
        /*) [ -e "$2" ] ;;
        Applications/*) [ -e "$HOME/$2" ] || [ -e "/$2" ] ;;
        *) [ -e "$HOME/$2" ] ;;
      esac
      ;;
    krew) printf '%s\n' "$KREW_LIST" | grep -qx "$2" ;;
    vscode) printf '%s\n' "$CODE_LIST" | grep -qix "$2" ;;
    *) return 0 ;;
  esac
}

# alt_present <kind> <value>: like present, but a binary the OS itself ships
# (/usr/bin, /bin) is not something the owner installed.
alt_present() {
  if [ "$1" = bin ]; then
    local where
    where=$(command -v "$2" 2>/dev/null) || return 1
    case "$where" in
      /usr/bin/* | /bin/* | /usr/sbin/* | /sbin/*) return 1 ;;
    esac
    return 0
  fi
  present "$1" "$2"
}

printf 'ignite doctor — %s, %s\n\n' {{ .ignite.os | squote }} {{ if .ignite.admin }}'admin'{{ else }}'no admin'{{ end }}

ok=0
missing=0
needs=0
echo "Tools"
while IFS=$'\t' read -r row name _job method kind value spec; do
  [ "$row" = expect ] || continue
  if present "$kind" "$value"; then
    status=ok
    [ "$kind" = none ] && status=unchecked
    version=""
    if [ "$method" = mise ] && command -v mise >/dev/null 2>&1; then
      version=$(mise current "$spec" 2>/dev/null | head -n 1)
    fi
    printf '  %-9s %-42s %s\n' "$status" "$name" "$version"
    ok=$((ok + 1))
  elif [ -n "$(report_detail needs-it "$name")" ]; then
    printf '  %-9s %s\n' "needs IT" "$name"
    needs=$((needs + 1))
  elif [ -n "$(report_detail skipped "$name")" ]; then
    printf '  %-9s %s\n' skipped "$name"
  else
    printf '  %-9s %s\n' MISSING "$name"
    missing=$((missing + 1))
  fi
done <<< "$CHECKS"

duplicates=""
while IFS=$'\t' read -r row name job _method kind value _spec; do
  [ "$row" = alt ] || continue
  if alt_present "$kind" "$value"; then
    chosen=$(awk -F '\t' -v j="$job" '$1 == "expect" && $3 == j { print $2; exit }' <<< "$CHECKS")
    duplicates="$duplicates  $job: ${chosen:-nothing} (selected) and $name (also installed)"$'\n'
  fi
done <<< "$CHECKS"
if [ -n "$duplicates" ]; then
  printf '\nDuplicates (one tool per job; remove the extra if you like)\n%s' "$duplicates"
fi

needs_it=$(awk -F '\t' '$2 == "needs-it" { printf "  %s: %s\n", $3, $4 }' "$REPORT")
if [ -n "$needs_it" ]; then
  printf '\nNeeds IT (no admin rights here)\n%s\n' "$needs_it"
fi
skipped=$(awk -F '\t' '$2 == "skipped" { printf "  %s: %s\n", $3, $4 }' "$REPORT")
if [ -n "$skipped" ]; then
  printf '\nSkipped\n%s\n' "$skipped"
fi
# retry_script <report source>: the chezmoi script that installs that source.
retry_script() {
  case "$1" in
{{- range $source, $script := includeTemplate "retry-scripts.json" . | fromJson }}
    {{ $source }}) echo {{ $script }} ;;
{{- end }}
  esac
}

failed=$(awk -F '\t' '$2 == "failed" { n++ } END { print n + 0 }' "$REPORT")
if [ "$failed" -gt 0 ]; then
  printf '\nFailed installs\n'
  awk -F '\t' '$2 == "failed" { printf "  %s (%s): %s\n", $3, $1, $4 }' "$REPORT"
  printf '  Retry (re-runs only the steps that failed):\n'
  while IFS= read -r source; do
    script=$(retry_script "$source")
    if [ -n "$script" ]; then
      printf "    chezmoi state delete --bucket=entryState --key='%s/.chezmoiscripts/%s.sh'\n" "$HOME" "$script"
    elif [ "$source" = bootstrap ]; then
      printf '    (bootstrap steps: run the bootstrap one-liner again)\n'
    fi
  done < <(awk -F '\t' '$2 == "failed" { print $1 }' "$REPORT" | sort -u)
  printf '    chezmoi apply\n'
fi

steps=""
step() {
  steps="$steps  [ ] $*"$'\n'
}
if command -v gh >/dev/null 2>&1 && ! gh auth status >/dev/null 2>&1; then
  step "Sign in to GitHub: gh auth login"
fi
{{- if eq .ignite.git_host "gitlab" }}
{{-   $host := .ignite.gitlab_url | trimPrefix "https://" | trimPrefix "http://" | trimSuffix "/" }}
if command -v glab >/dev/null 2>&1 && ! glab auth status --hostname {{ $host | squote }} >/dev/null 2>&1; then
  step "Sign in to GitLab: glab auth login --hostname {{ $host }}"
fi
{{- end }}
{{- if .ignite.cloud_aws }}
if command -v aws >/dev/null 2>&1 && [ -z "$(aws configure list-profiles 2>/dev/null)" ]; then
  step "Set up AWS access: aws configure sso"
fi
{{- end }}
{{- if .ignite.cloud_azure }}
if command -v az >/dev/null 2>&1 && ! az account show >/dev/null 2>&1; then
  step "Sign in to Azure: az login"
fi
{{- end }}
{{- if .ignite.cloud_gcp }}
if command -v gcloud >/dev/null 2>&1 && [ -z "$(gcloud auth list --format='value(account)' 2>/dev/null)" ]; then
  step "Sign in to Google Cloud: gcloud auth login"
fi
{{- end }}
if [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
  step "Add this laptop's SSH key at https://github.com/settings/ssh/new{{ if eq .ignite.git_host "gitlab" }} and {{ .ignite.gitlab_url | trimSuffix "/" }}/-/user_settings/ssh_keys{{ end }}:"
  steps="$steps      $(cat "$HOME/.ssh/id_ed25519.pub")"$'\n'
  if ssh-keygen -y -P "" -f "$HOME/.ssh/id_ed25519" >/dev/null 2>&1; then
    step "Optional: give the key a passphrase: ssh-keygen -p -f ~/.ssh/id_ed25519"
  fi
fi
secrets_file="$HOME/.config/ignite/secrets.env"
if [ -f "$secrets_file" ]; then
  empty=$(sed -nE "s/^(export )?([A-Za-z_][A-Za-z0-9_]*)=(''|\"\")?[[:space:]]*$/\2/p" "$secrets_file" | tr '\n' ' ')
  if [ -n "$empty" ]; then
    step "Fill in secrets in ~/.config/ignite/secrets.env: $empty"
  fi
fi
if [ -n "$steps" ]; then
  printf '\nManual steps\n%s' "$steps"
fi

printf '\nSummary: %d ok, %d missing, %d needs IT, %d failed\n' "$ok" "$missing" "$needs" "$failed"
[ "$missing" -eq 0 ]
